model
  schema 1.1

type user

type team
  relations
    define member: [user]

type organization
  relations
    define admin: [team#member]
    define platform_engineer: [team#member] or admin
    define developer: [team#member] or platform_engineer
    define viewer: [team#member] or developer

type cluster
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type catalog_item
  relations
    define parent: [organization]
    define deployer: developer from parent
    define viewer: viewer from parent

type resource_instance
  relations
    define parent: [cluster]
    define editor: operator from parent
    define viewer: viewer from parent

type cloud_account
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type policy_pack
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type cluster_set
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type tenant_zone
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type extension
  relations
    define parent: [organization]
    define invoke: platform_engineer from parent or developer from parent
    define viewer: viewer from parent

type rollout
  relations
    define parent: [organization]
    define operator: platform_engineer from parent
    define viewer: viewer from parent

type drift_event
  relations
    define parent: [organization]
    define viewer: viewer from parent
