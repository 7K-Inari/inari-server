apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Values.repoName }}-root
  namespace: argocd
  labels:
    inari.io/org-id: {{ .Tenant.OrgID }}
    inari.io/tenant: {{ .Tenant.Slug }}
    inari.io/run: {{ .Run.Name }}
spec:
  project: {{ .Values.team }}
  source:
    repoURL: {{ .Values.repoName }}
    targetRevision: {{ .Values.baseBranch }}
    path: .
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
